# URL publique de votre futur déploiement, sans slash final.
# NEXT_PUBLIC_SITE_URL=https://votre-domaine.example

# Clé privée Printify, utilisée uniquement lors du rendu/build côté serveur.
PRINTIFY_API_KEY=
# Requis seulement si le compte Printify contient plusieurs boutiques.
PRINTIFY_SHOP_ID=29655535
# URL publique de la boutique pour les liens « Visit the shop ».
PRINTIFY_SHOP_URL=https://shop.evancrossmusic.com
